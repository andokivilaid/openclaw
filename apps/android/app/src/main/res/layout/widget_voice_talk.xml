<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_voice_talk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_voice_talk_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/widget_voice_talk_mic_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_mic_button_background"
        android:contentDescription="@string/voice_talk_widget_label"
        android:padding="10dp"
        android:src="@drawable/ic_widget_mic" />

    <TextView
        android:id="@+id/widget_voice_talk_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/voice_talk_widget_label"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp" />
</LinearLayout>
